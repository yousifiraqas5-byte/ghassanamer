rules_version='2'

service cloud.firestore {

  // Helper: is the request coming from the owner of this account?
  function isOwnerOfAccount(userId) {
    return request.auth != null && request.auth.uid == userId;
  }

  match /databases/{database}/documents {
    // Cargo/load requests published by cargo owners
    match /loads/{loadId} {
      // Anyone can read loads (drivers browsing available shipments)
      allow read: if true;

      // Anyone can create a load request, but must include all required fields
      allow create: if request.resource.data.keys().hasAll([
        'fromLocation',
        'toLocation',
        'cargoType',
        'cargoWeight',
        'cargoWeightUnit',
        'truckType',
        'cargoPrice',
        'status',
        'createdAt'
      ]) && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'available';

      // Updates only allowed while load is still available (not yet accepted)
      allow update: if resource.data.status != 'accepted';

      // No deletes allowed (prevent accidental data loss)
      allow delete: if false;
    }

    // Price offers submitted by drivers for a specific load
    match /offers/{offerId} {
      // Anyone can read offers (owners/drivers viewing offers on a load)
      allow read: if true;

      // Anyone can submit an offer, but must include all required fields
      allow create: if request.resource.data.keys().hasAll([
        'loadId',
        'price',
        'status',
        'createdAt'
      ]) && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'pending';

      // Status updates only (accepting/rejecting an offer)
      allow update: if resource.data.status == 'pending';

      // No deletes allowed (prevent accidental data loss)
      allow delete: if false;
    }

    // User profiles created via Google Sign-In (Firebase Authentication)
    // Document ID = Firebase Auth uid
    // Data = { name, email, photoURL, displayName, createdAt, updatedAt }
    match /users/{userId} {
      // Only the signed-in owner can read their own profile
      allow read: if isOwnerOfAccount(userId);

      // Owner creates their own profile with only the fields they are allowed
      // to set (name, email, photoURL, displayName). createdAt is server-set.
      allow create: if isOwnerOfAccount(userId)
        && request.resource.data.keys().hasAll([
          'name',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string
        && (!('phone' in request.resource.data))
        && (!('phone_number' in request.resource.data));

      // Owner updates their own profile (name, email, photoURL, displayName).
      // createdAt is never part of the update payload in the app.
      allow update: if isOwnerOfAccount(userId)
        && (!('phone' in request.resource.data))
        && (!('phone_number' in request.resource.data));

      // No deletes allowed (prevent accidental data loss)
      allow delete: if false;
    }

    // Block all other document paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
